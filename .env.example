# Copy to .env.local and fill in to enable cloud sync (Settings -> Cloud sync).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Re:amaze support integration (server-side only).
# These power /api/reamaze and must NEVER be prefixed with NEXT_PUBLIC_ —
# the token is a secret and must not reach the browser. Requires a server
# host (Vercel / `next start`); the static GitHub Pages build ignores them.
REAMAZE_BRAND=          # the {brand} in {brand}.reamaze.io
REAMAZE_LOGIN_EMAIL=    # login email the API token belongs to
REAMAZE_API_TOKEN=      # secret API token — rotate if ever exposed
