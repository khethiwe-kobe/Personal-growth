# Copy to .env.local for local development. On Vercel, set these under
# Project Settings -> Environment Variables (the database ones are added for you
# when you connect a Neon database from the Storage tab).

# Postgres connection string. Vercel's Neon integration sets DATABASE_URL.
# For local development without Postgres: DATABASE_URL=pglite:./.data/pg
DATABASE_URL=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The JHB group's join code. People need it once, to create their account.
COACH_PASSCODE=

# Optional: override the model (default gemini-3.8-flash).
GEMINI_MODEL=

# Optional: models to try when the main one is overloaded (default gemini-3.6-flash,gemini-3.5-flash-lite).
GEMINI_FALLBACK_MODELS=
