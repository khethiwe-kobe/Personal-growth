# Copy to .env.local for local development, and add the same values in Vercel
# (Project Settings -> Environment Variables) for the live app.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared passcode people enter once per device. Leave empty to make the app open to anyone with the link.
COACH_PASSCODE=

# Optional: override the model (default gemini-3.8-flash).
GEMINI_MODEL=

# Optional: models to try when the main one is overloaded (default gemini-3.6-flash,gemini-3.5-flash-lite).
GEMINI_FALLBACK_MODELS=
