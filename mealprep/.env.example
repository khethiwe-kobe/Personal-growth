# SQLite file location (default ./data/mealprep.db)
MEALPREP_DB_PATH=./data/mealprep.db
# Cookie-session secret (required in production)
MEALPREP_SESSION_SECRET=change-me-to-a-long-random-string
# Public base URL used in QR codes / label links
MEALPREP_PUBLIC_URL=http://localhost:3200
# Optional outbound integration webhook (Make.com / Zapier / n8n). Every
# automation event is POSTed here as JSON when set.
MEALPREP_WEBHOOK_URL=
MEALPREP_WEBHOOK_SECRET=
